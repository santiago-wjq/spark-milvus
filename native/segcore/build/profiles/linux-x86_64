# Settings only. Package options come from milvus/internal/core/conanfile.py so
# the dependency graph is the one Milvus itself ships with.
[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=12
compiler.libcxx=libstdc++11
compiler.cppstd=20
build_type=Release

[conf]
tools.build:compiler_executables={"c": "gcc-12", "cpp": "g++-12"}

[platform_tool_requires]
cmake/3.27.5
